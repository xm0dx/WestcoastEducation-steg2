<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Add Resources Here -->

  <!-- bara färgerna ligger här, penslarna som använder dem finns i AppResources.axaml -->
  <Color x:Key="PrimaryForegroundColor">#EAE8E8</Color>
  <Color x:Key="PrimaryBackgroundColor">#04041F</Color>
  <!-- röd färg för t.ex. ta bort-knappar och felmeddelanden -->
  <Color x:Key="DangerColor">#940202</Color>
</ResourceDictionary>
