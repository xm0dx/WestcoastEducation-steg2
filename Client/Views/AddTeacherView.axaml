<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Client.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Client.Views.AddTeacherView"
             x:DataType="vm:AddTeacherViewModel">

  <Design.DataContext>
    <vm:AddTeacherViewModel></vm:AddTeacherViewModel>
  </Design.DataContext>

  <StackPanel>
    <TextBlock Classes="pageTitle" Text="{Binding PageTitle}" />

    <Border HorizontalAlignment="Center" Padding="0 30" BorderBrush="White" BorderThickness="0">
      <StackPanel>
        <Grid RowSpacing="10" ColumnSpacing="10" ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
          <Label Classes="form" HorizontalAlignment="Right" Content="Förnamn"/>
          <Label Classes="form" Grid.Row="1" HorizontalAlignment="Right" Content="Efternamn"/>
          <Label Classes="form" Grid.Row="2" HorizontalAlignment="Right" Content="Personnummer"/>
          <Label Classes="form" Grid.Row="3" HorizontalAlignment="Right" Content="Telefon"/>
          <Label Classes="form" Grid.Row="4" HorizontalAlignment="Right" Content="Adress"/>
          <Label Classes="form" Grid.Row="5" HorizontalAlignment="Right" Content="Postnummer"/>
          <Label Classes="form" Grid.Row="6" HorizontalAlignment="Right" Content="Ort"/>
          <Label Classes="form" Grid.Row="7" HorizontalAlignment="Right" Content="Kompetensområde"/>

          <TextBox Grid.Column="1" Text="{Binding FirstName}" HorizontalAlignment="Left" />
          <TextBox Grid.Column="1" Grid.Row="1" Text="{Binding LastName}" HorizontalAlignment="Left" />
          <TextBox Grid.Column="1" Grid.Row="2" Text="{Binding PersonalNumber}" HorizontalAlignment="Left" />
          <TextBox Grid.Column="1" Grid.Row="3" Text="{Binding Phone}" HorizontalAlignment="Left" />
          <TextBox Grid.Column="1" Grid.Row="4" Text="{Binding Address}" HorizontalAlignment="Left" />
          <TextBox Grid.Column="1" Grid.Row="5" Text="{Binding PostalCode}" HorizontalAlignment="Left" />
          <TextBox Grid.Column="1" Grid.Row="6" Text="{Binding City}" HorizontalAlignment="Left" />
          <TextBox Grid.Column="1" Grid.Row="7" Text="{Binding KnowledgeArea}" HorizontalAlignment="Left" />
        </Grid>

        <TextBlock Foreground="{DynamicResource Danger}" TextAlignment="Center" Margin="0 20 0 0" Text="{Binding Message}" />

        <StackPanel Spacing="20" Margin="0 20 0 0" Orientation="Horizontal" HorizontalAlignment="Center">
          <Button Classes="form" Command="{Binding SaveCommand}">
            <StackPanel Orientation="Horizontal">
              <Label Padding="5" FontFamily="{DynamicResource IconFont}" Content="&#xe248;" />
              <Label Content="Spara" />
            </StackPanel>
          </Button>
          <Button Classes="form" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).GoToTeachersCommand}">
            <StackPanel Orientation="Horizontal">
              <Label Padding="5" FontFamily="{DynamicResource IconFont}" Content="&#xe08a;" />
              <Label Content="Avbryt" />
            </StackPanel>
          </Button>
        </StackPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
