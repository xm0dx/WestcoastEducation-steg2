<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Client.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        Height="768" Width="1100"
        x:Class="Client.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Westcoast Education">

    <!-- två kolumner: menyn (Auto = så bred som innehållet) och sidan (* = resten) -->
    <Grid ColumnDefinitions="Auto,*" Background="{DynamicResource BackgroundColor}">
        <Border Padding="10" Background="{DynamicResource PrimaryBackgroundGradient}">
            <StackPanel Spacing="10" MinWidth="200">
                <TextBlock Margin="10 10 10 20" Text="Westcoast Education" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ForegroundColor}" />
                <!-- Command binder till GoToHomeCommand som [RelayCommand] skapade av metoden GoToHome -->
                <Button Command="{Binding GoToHomeCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Label Padding="0 4" FontFamily="{DynamicResource IconFont}" Content="&#xe2c2;" />
                        <Label Content="Hem" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
        <!-- här visas sidan. Content är en ViewModel, ViewLocator byter den mot rätt View -->
        <UserControl Grid.Column="1" Padding="30" Content="{Binding CurrentView}" />
    </Grid>
</Window>
